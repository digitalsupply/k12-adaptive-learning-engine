# LLM 出题配置（OpenAI 兼容接口，三项配齐即启用；失败自动退回模板出题）
# 复制本文件为 .env 后填入你的 Key。.env 已被 .gitignore 忽略，不会提交。
#
# ↓↓↓ DeepSeek（推荐，便宜稳定）：
K12_LLM_BASE_URL=https://api.deepseek.com/v1
K12_LLM_API_KEY=sk-你的Key
K12_LLM_MODEL=deepseek-chat

# 阿里云百炼（通义千问）：
#K12_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#K12_LLM_MODEL=qwen-plus

# 智谱清言（GLM）：
#K12_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#K12_LLM_MODEL=glm-4-flash

# 可选：超时秒数（默认 45）与最大生成 token 数（默认 2000）
#K12_LLM_TIMEOUT=45
#K12_LLM_MAX_TOKENS=2000
